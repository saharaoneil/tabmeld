{
  "manifest_version": 3,
  "name": "TabMeld",
  "version": "1.0",
  "description": "Synthesize your research tabs into insights",
  
  "permissions": ["tabs", "scripting", "storage", "downloads"],
  "host_permissions": ["<all_urls>"],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_start"
    }
  ],
  
  "action": {
    "default_popup": "popup.html",
    "default_title": "TabMeld"
  }
}